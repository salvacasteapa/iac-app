# Dirección pública de la aplicación (para los enlaces de pago)
BASE_URL=https://tu-dominio.com
# Tu email: al registrarte con él tendrás el panel de Administración IAC
ADMIN_EMAIL=tu@email.com
# Días de prueba gratis al crear una empresa
TRIAL_DAYS=14
# Precios mostrados (€/mes)
PRICE_COMPRADOR=29
PRICE_VENDEDOR=99
PRICE_EMPRESA=149
# Cobro con Stripe (si se dejan vacíos, la app funciona en modo demostración sin cobrar)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_COMPRADOR=
STRIPE_PRICE_VENDEDOR=
STRIPE_PRICE_EMPRESA=
# Instrucciones en lenguaje natural para los agentes (opcional, clave de la API de Anthropic)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5

# WhatsApp (extra de pago): API oficial de Meta. Sin estas variables, WhatsApp queda desactivado.
# WHATSAPP_TOKEN=token permanente del usuario del sistema de Meta
# WHATSAPP_PHONE_ID=identificador del número de WhatsApp Business
# WHATSAPP_TEMPLATE=aviso_iac   (plantilla aprobada con 3 variables: {{1}} título, {{2}} detalle, {{3}} enlace)
# Notificaciones push: las claves se generan solas y se guardan en el disco de datos.

# Precios y límites (opcionales; estos son los valores por defecto)
# PRICE_COMPRADOR=19
# PRICE_VENDEDOR=49
# PRICE_EMPRESA=199
# PRICE_CONEXION=14             # el cliente paga la conexión de su proveedor
# STRIPE_PRICE_CONEXION=price_... # precio mensual de 14 € en Stripe
# MAX_CONEXIONES=100            # tope de conexiones de los planes Compras y Ventas
# PROMO_CLIENTES=50             # clientes que un proveedor puede invitar gratis
# PROMO_DIAS=180                # duración de la promoción
# NEGOCIACIONES_INCLUIDAS=1000  # plan Compras + Ventas, al mes
# PRECIO_NEGOCIACION_EXTRA=0.99
